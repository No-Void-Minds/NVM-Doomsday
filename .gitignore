# File env berisi sandi dan secret. Hanya contohnya yang boleh masuk git.
.env
.env.*
!.env.example

backend/bin/
backend/tmp/
*.test
*.out
coverage.*

frontend/node_modules/
frontend/dist/
*.tsbuildinfo
# Tanpa awalan folder supaya node_modules di mana pun tidak pernah ikut ter-commit,
# termasuk kalau npm install tidak sengaja dijalankan di root repo.
node_modules/
*.log

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Hasil pg_dump berisi data pribadi peserta, jangan sampai ikut ter-push.
*.sql.gz
*.dump

