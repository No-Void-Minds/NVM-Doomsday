# Salin ke deploy/.env di VM lalu isi. Repo ini public: deploy/.env tidak boleh masuk git.

# Dibaca Compose
PG_NETWORK=nvm-internal_default
PG_CONTAINER=nvm-internal-postgres
DOOMSDAY_SUBNET=172.30.93.0/24
DOOMSDAY_PORT=8090

# Dibaca backend
APP_ENV=production
HTTP_ADDR=:8080
# Host dan port di sini adalah alamat Postgres di network Docker, bukan tunnel 15432.
DATABASE_URL=postgres://doomsday_app:GANTI_SANDI@nvm-internal-postgres:5432/nvm_doomsday?sslmode=disable
# Harus sama dengan DOOMSDAY_SUBNET.
TRUSTED_PROXIES=172.30.93.0/24
# Wajib pakai kutip tunggal. Tanpa kutip, Compose membaca $2a, $12, dan seterusnya sebagai variabel
# lalu menggantinya dengan string kosong, sehingga hash rusak.
ADMIN_PASSWORD_HASH='GANTI_DENGAN_HASIL_doomsday-admin_hash-password'
# Minimal 32 karakter. Buat dengan: openssl rand -base64 48
SESSION_SECRET=
# Tetap false selama akses lewat HTTP LAN. Jadi true di Sprint 10 setelah ada HTTPS.
COOKIE_SECURE=false
