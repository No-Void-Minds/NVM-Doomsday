# development atau production. Production mematikan log debug Gin.
APP_ENV=development

# Di laptop cukup localhost. Di container nanti diisi :8081 supaya bisa dijangkau Nginx.
HTTP_ADDR=127.0.0.1:8081
# Backend login sebagai doomsday_app (hanya SELECT, INSERT, UPDATE).
# Di laptop lewat SSH tunnel: 127.0.0.1:15432. sslmode=disable karena jalurnya sudah dienkripsi SSH,
# dan di server nanti koneksinya lewat network Docker internal yang tidak keluar dari VM.
DATABASE_URL=postgres://doomsday_app:GANTI_SANDI@127.0.0.1:15432/nvm_doomsday?sslmode=disable
# Hanya untuk perintah migrate, tidak dibaca server. Login sebagai pemilik tabel.
MIGRATE_DATABASE_URL=postgres://doomsday_migrator:GANTI_SANDI@127.0.0.1:15432/nvm_doomsday?sslmode=disable
# Daftar IP atau CIDR proxy yang dipercaya membaca X-Forwarded-For, dipisah koma.
# Kosong di laptop. Di server diisi subnet network Docker Nginx (Sprint 8).
TRUSTED_PROXIES=
