root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# gofmt memakai tab, jadi editor harus ikut supaya diff tidak berantakan.
[*.go]
indent_style = tab

# Di Markdown, dua spasi di akhir baris berarti pindah baris.
[*.md]
trim_trailing_whitespace = false